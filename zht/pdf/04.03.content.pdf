    <rdf:li>Siegfried Mittmann</rdf:li>
    <rdf:li>Wolfgang Zwickel</rdf:li>
   </rdf:Bag>
  </dc:subject>
  <dc:title>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>Das eherne Meer</rdf:li>
