   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Im babylonischen Exil entwarf der Prophet Hesekiel eine neue Gestalt des Tempels, wie er nach der RÃ¼ckkehr aus dem Exil wieder aufgebaut werden solle. Auf den Palast, der gleichfalls auf dem Tempelberg stand, wurde nun verzichtet. Auch die mit Bildsymbolik versehenen SÃ¤ulen Jachin und Boas, das eherne Meer und die Kesselwagen wurden nicht mehr Ã¼bernommen. Das ganze Areal war nun sehr symmetrisch ausgerichtet. Vor dem Tempel lag nach diesem Entwurf ein quadratischer Hof, zu dem man Ã¼ber drei Toranlagen Zugang erhielt.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>schwarz-weiÃŸ</rdf:li>
               <rdf:li>Hugo Lange</rdf:li>
               <rdf:li>Karl Elliger</rdf:li>
               <rdf:li>TBB</rdf:li>
               <rdf:li>Zeichnung</rdf:li>
               <rdf:li>SW</rdf:li>
               <rdf:li>Heiner Bauschert</rdf:li>
               <rdf:li>Siegfried Mittmann</rdf:li>
               <rdf:li>Tausend-Bilder-Bibel</rdf:li>
               <rdf:li>Wolfgang Zwickel</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Tempelentwurf des Hesekiel</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:format>image/jpeg</dc:format>
      </rdf:Description>
