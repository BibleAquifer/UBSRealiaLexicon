"content": "<style>\nh1.thlex-title { font-size: 1.3em; margin: 0 0 0.4em; }\n.thlex-key { color: #888; font-size: 0.85em; font-weight: normal; margin-right: 0.4em; }\nnav.thlex-index { margin: 0.5em 0 0.75em; }\nnav.thlex-index ul { margin: 0; padding-left: 1.2em; }\nnav.thlex-index li { margin: 0.15em 0; font-size: 0.95em; }\n.thlex-section { margin: 0.6em 0; }\nh2.thlex-heading { font-size: 1em; margin: 0.5em 0 0.2em; }\nh3.thlex-subheading { font-size: 0.95em; font-weight: normal; font-style: italic; margin: 0.2em 0; }\n.thlex-language-sets { margin: 0.3em 0 0.3em 1em; }\n.thlex-language-set { margin: 0.4em 0; padding-left: 0.75em; border-left: 3px solid #e0e0e0; }\n.thlex-language { font-size: 0.8em; color: #888; margin-right: 0.4em; }\n.thlex-lemma { font-weight: bold; font-family: serif; }\n.thlex-translit { color: #555; font-style: italic; font-size: 0.9em; margin-left: 0.3em; }\n.thlex-refs { font-size: 0.85em; color: #444; margin-top: 0.15em; }\n.thlex-paragraphs p { margin: 0.35em 0; font-size: 0.95em; line-height: 1.5; }\n.thlex-image { margin: 0.5em 0; display: block; }\n.thlex-image img { max-width: 100%; height: auto; display: block; }\nfigcaption.thlex-caption { font-size: 0.85em; color: #555; font-style: italic; margin-top: 0.2em; }\n.thlex-abbr { border-bottom: 1px dotted #888; cursor: help; }\n.thlex-xref { color: #1a5fb4; }\ntable.thlex-table { border-collapse: collapse; font-size: 0.9em; margin: 0.5em 0; }\ntable.thlex-table td { padding: 0.2em 0.6em; vertical-align: top; border: 1px solid #ddd; }\ntable.thlex-table tr:first-child td { font-weight: bold; background: #f5f5f5; }\nul.thlex-index-list { margin: 0.4em 0; padding-left: 1.4em; font-size: 0.95em; line-height: 1.6; }\nul.thlex-index-list ul { margin: 0.1em 0; padding-left: 1.4em; }\n.thlex-index-key { font-weight: bold; font-style: italic; }\n</style><h1 class=\"thlex-title\" id=\"REALIA:3.4\"><span class=\"thlex-key\">3.4</span> Palace</h1><div class=\"thlex-section\">\n<h2 class=\"thlex-heading\">References:</h2>\n<div class=\"thlex-language-sets\">\n<div class=\"thlex-language-set\">\n<span class=\"thlex-language\">Hebrew</span> <span class=\"thlex-lemma\">אַרְמוֹן</span> <span class=\"thlex-translit\">(’armon)</span>\n<div class=\"thlex-refs\"><data class=\"bible-ref\" data-start-ref=\"11016018\" data-end-ref=\"11016018\">1KI 16:18</data>, <data class=\"bible-ref\" data-start-ref=\"12015025\" data-end-ref=\"12015025\">2KI 15:25</data>, <data class=\"bible-ref\" data-start-ref=\"14036019\" data-end-ref=\"14036019\">2CH 36:19</data></div>\n</div>\n<div class=\"thlex-language-set\">\n<span class=\"thlex-language\">Hebrew</span> <span class=\"thlex-lemma\">בִּירָה</span> <span class=\"thlex-translit\">(birah)</span>\n<div class=\"thlex-refs\"><data class=\"bible-ref\" data-start-ref=\"13029001\" data-end-ref=\"13029001\">1CH 29:1</data>, <data class=\"bible-ref\" data-start-ref=\"13029019\" data-end-ref=\"13029019\">1CH 29:19</data></div>\n</div>\n<div class=\"thlex-language-set\">\n<span class=\"thlex-language\">Hebrew</span> <span class=\"thlex-lemma\">בַּיִת</span> <span class=\"thlex-translit\">(bayith)</span>\n<div class=\"thlex-refs\"><data class=\"bible-ref\" data-start-ref=\"01012015\" data-end-ref=\"01012015\">GEN 12:15</data>, <data class=\"bible-ref\" data-start-ref=\"01012017\" data-end-ref=\"01012017\">GEN 12:17</data>, <data class=\"bible-ref\" data-start-ref=\"01041040\" data-end-ref=\"01041040\">GEN 41:40</data>, <data class=\"bible-ref\" data-start-ref=\"01045002\" data-end-ref=\"01045002\">GEN 45:2</data>, <data class=\"bible-ref\" data-start-ref=\"01045008\" data-end-ref=\"01045008\">GEN 45:8</data>, <data class=\"bible-ref\" data-start-ref=\"01045016\" data-end-ref=\"01045016\">GEN 45:16</data>, <data class=\"bible-ref\" data-start-ref=\"01047014\" data-end-ref=\"01047014\">GEN 47:14</data>, <data class=\"bible-ref\" data-start-ref=\"01050004\" data-end-ref=\"01050004\">GEN 50:4</data></div>\n</div>\n<div class=\"thlex-language-